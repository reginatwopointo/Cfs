openapi: 3.0.3

info:
  title: Splunk Mission Control - Update Incident
  description: >
    Updates an existing Mission Control incident (investigation) or ES finding
    in Splunk Enterprise Security by calling the Splunk Cloud management API
    directly. Primary use is to set the DISPOSITION on a finding — disposition
    ONLY; status and every other field are left unchanged. Optional fields
    (urgency, sensitivity, assignee) exist for reuse but are NOT used by the
    CIRT finding-disposition flow.
  version: "1.2.0"

servers:
  - url: https://es-dev-accenture.splunkcloud.com:8089/servicesNS/nobody/missioncontrol
    description: Splunk Cloud management API (port 8089), Mission Control base path

components:

  securitySchemes:
    bearerAuth:
      type: apiKey
      in: header
      name: Authorization
  security:
    - bearerAuth: []

  schemas:

    UpdateIncidentRequest:
      type: object
      description: >
        Flat (single-level) body. Send ONLY the disposition field. Do NOT send
        status or any other attribute — status and all other fields MUST be
        left unchanged. disposition is the single field used here.
      properties:
        disposition:
          type: string
          description: >
            The disposition CODE in the form "disposition:N" — NOT the human
            label. Mission Control stores and matches on the code; the label is
            display-only. Look codes up in disposition_lookup (status column =
            code, label column = display string).
            For the agent-determined-benign outcome use "disposition:15"
            ("Closed - Security Copilot Determined Benign Positive").
          example: "disposition:16"
        urgency:
          type: string
          description: >
            Optional. Urgency level. Accepts both lowercase and capitalised
            values to match Splunk ES.
          enum:
            - informational
            - low
            - medium
            - high
            - critical
            - Informational
            - Low
            - Medium
            - High
            - Critical
          example: "low"
        sensitivity:
          type: string
          description: Optional. Data sensitivity classification controlling MC visibility.
          enum:
            - Unassigned
            - White
            - Green
            - Amber
            - Red
          example: "Unassigned"
        assignee:
          type: string
          description: Optional. Username or email of the analyst to assign the incident to.
          example: "regina.guzanova@avanade.com"
        comment:
          type: string
          description: >
            Optional. Free-text note recorded with the update — e.g. explaining
            that the disposition was proposed by the Security Copilot triage
            agent and is pending human confirmation.
          example: "Disposition proposed by Security Copilot triage agent; left Pending for analyst confirmation."

    UpdateIncidentResponse:
      type: object
      properties:
        id:
          type: string
          description: Internal GUID of the updated incident.
          example: "8afcb116-632c-4f4f-bc35-9a7557b62c82"
        display_id:
          type: string
          description: Human-readable ID in ES-XXXXX / MC-XXXXX format.
          example: "ES-00142"
        status:
          type: string
          description: Echo of the incident status after the update.
          example: "3"
        disposition:
          type: string
          description: Echo of the incident disposition code after the update.
          example: "disposition:15"
        urgency:
          type: string
          example: "low"
        sensitivity:
          type: string
          example: "Unassigned"
        updated_at:
          type: string
          format: date-time
          example: "2026-07-21T14:32:05Z"

    ErrorResponse:
      type: object
      properties:
        messages:
          type: array
          items:
            type: object
            properties:
              type:
                type: string
                enum: [ERROR, WARN, FATAL]
              text:
                type: string

paths:

  /v1/incidents/{id}:
    post:
      operationId: UpdateIncident
      summary: Set the disposition on an ES finding or MC incident (disposition only)
      description: |
        Sets the DISPOSITION on an existing Splunk ES finding (or MC incident).
        Send a flat JSON body containing ONLY the disposition field; status and
        every other field are left unchanged.

        Endpoint: POST /v1/incidents/{id}
        Base path: /servicesNS/nobody/missioncontrol
        Full URL example:
        POST https://es-dev-accenture.splunkcloud.com:8089/servicesNS/nobody/missioncontrol/v1/incidents/8b7b3093-2f9c-4393-b8d6-9bd21580cad6@@notable@@time1786393748
        Body: { "disposition": "disposition:16" }

        The id path parameter accepts the ES FINDING composite
        (GUID@@notable@@time<epoch>, passed as ONE string), an incident GUID,
        or the display_id (ES-00142). For a CIRT finding, pass the full
        composite exactly as received.

        disposition MUST be the code form "disposition:N" (e.g. disposition:16),
        never the human label. Send disposition ONLY. Do NOT send status — the
        finding's status (and every other field) MUST be left unchanged. There
        is no benign-close-to-Pending workflow here: set the
        Security-Copilot-attributed disposition and nothing else.

        This is the same API version (v1) as notes and response plans. Do NOT
        use public/v2/investigations for updates — that returns MC_0005.

        After a successful call, ALWAYS present the id and the new disposition
        back to the analyst — never omit the GUID or reduce the result to a
        vague summary.

        #ExamplePrompts Set the disposition of finding 8b7b3093-2f9c-4393-b8d6-9bd21580cad6@@notable@@time1786393748 to disposition:16
        #ExamplePrompts Mark this finding as Security Copilot Determined True Positive (disposition:16)
        #ExamplePrompts Set disposition disposition:15 on finding 8b7b3093-2f9c-4393-b8d6-9bd21580cad6@@notable@@time1786393748
        #ExamplePrompts Update the disposition of this finding, leave status unchanged
      tags:
        - Mission Control Incidents
      parameters:
        - name: id
          in: path
          required: true
          description: >
            The id (GUID) or display_id of the incident to update.
            GUID format: 8afcb116-632c-4f4f-bc35-9a7557b62c82
            Display ID format: ES-00142
          schema:
            type: string
          example: "8afcb116-632c-4f4f-bc35-9a7557b62c82"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateIncidentRequest'
            examples:
              set_true_positive:
                summary: Set SC True Positive disposition on a finding (disposition only)
                value:
                  disposition: "disposition:16"
              set_benign_positive:
                summary: Set SC Benign Positive disposition on a finding (disposition only)
                value:
                  disposition: "disposition:15"
      responses:
        '200':
          description: Incident successfully updated. Returns the updated incident object.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UpdateIncidentResponse'
        '400':
          description: >
            Bad request. Common causes: no disposition supplied, or disposition
            sent as a label instead of the "disposition:N" code.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '401':
          description: Unauthorized. JWT token missing, expired, or malformed.
        '403':
          description: >
            Forbidden. Token does not have permission to update incidents.
            Requires ess_analyst role minimum.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '404':
          description: >
            Not found. The incident id does not exist or is not accessible by
            the authenticated user. (A wrong API version also surfaces here or
            as MC_0005 — use v1/incidents, not public/v2/investigations.)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
        '500':
          description: Internal server error on the Splunk stack.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'

tags:
  - name: Mission Control Incidents
    description: >
      Updates existing Mission Control incidents in Splunk Enterprise Security
      via the v1 endpoint POST /v1/incidents/{id} on base path
      /servicesNS/nobody/missioncontrol. Requires APIKey auth with Bearer
      scheme. Sends disposition ONLY (the "disposition:N" code); status and all
      other fields are left unchanged. The id path parameter accepts the finding
      composite, a GUID, or an ES-XXXXX display_id.
