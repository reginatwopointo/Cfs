openapi: 3.0.3
info:
  title: Splunk Enterprise Security — Add Finding Note (public/v2)
  description: >
    Creates a note on a Splunk Enterprise Security 8 FINDING (or investigation)
    via the official ES public/v2 findings-notes endpoint. Writes the note
    directly onto the finding — does NOT require creating a Mission Control
    investigation first.

    Endpoint reference: ES 8.x API Reference > Findings >
    "Create a note in a finding or investigation" (public_v2_create_note_in_investigation).

    IMPORTANT — the finding composite id is SPLIT across two parameters:
      * {id} PATH param   = the bare finding GUID (source_guid), NOT the
        @@notable@@time composite.
      * notable_time QUERY param = the finding _time (the epoch after "@@time"
        in the composite, or ISO/relative time).
      e.g. source_event_id 2694b8bf-...-7e61af8f4aad@@notable@@time1784674442
           -> id = 2694b8bf-...-7e61af8f4aad
           -> notable_time = 1784674442
  version: 1.0.0

servers:
  - url: https://es-dev-accenture.splunkcloud.com:8089/servicesNS/nobody/missioncontrol

paths:
  /public/v2/investigations/{id}/notes:
    post:
      operationId: AddFindingNote
      summary: Create a note on an ES finding (or investigation)
      description: |
        Creates a note (title + content) on an ES 8 finding or investigation,
        identified by its GUID (or display_id) in the {id} path parameter. For a
        FINDING, also pass notable_time (query) — the finding's _time — so ES can
        locate the notable. Use this to write Security Copilot analysis directly
        onto a finding WITHOUT opening a Mission Control investigation.

        PATH PARAMETER:
        - id: the finding/investigation GUID (source_guid) or display_id. This is
          the BARE GUID only — do NOT append @@notable@@time...
          e.g. 2694b8bf-2cb6-4e91-97d7-7e61af8f4aad

        QUERY PARAMETER:
        - notable_time: the finding _time. Accepts epoch (1784674442), ISO
          (2026-07-21T15:54:00Z), or relative (-30m). For a finding built from a
          GUID@@notable@@time<epoch> composite, pass the <epoch> after "@@time".
          Optional for investigations; SEND IT for findings.

        BODY (application/json):
        - title: short label for the note.
        - content: full note body — paste the consolidated analysis here (required).
        - files: optional array of file IDs.
        - type: optional note type (sample shows "Task"). Omit for a plain
          finding note unless a specific type is required.

        #ExamplePrompts
        - Create a note on finding 2694b8bf-2cb6-4e91-97d7-7e61af8f4aad (notable_time 1784674442) with the Security Copilot analysis.
        - AddFindingNote id 2694b8bf-... notable_time 1784674442 title "Triage Summary" content "..."
        - Append this analysis to the ES finding without opening an investigation: [text]
      parameters:
        - name: id
          in: path
          required: true
          description: >
            The finding/investigation GUID (source_guid) or display_id. BARE GUID
            only — never the @@notable@@time composite.
          schema:
            type: string
            example: "2694b8bf-2cb6-4e91-97d7-7e61af8f4aad"
        - name: notable_time
          in: query
          required: false
          description: >
            The finding _time (epoch, ISO, or relative). For findings, pass the
            epoch after "@@time" in the source_event_id composite.
          schema:
            type: string
            example: "1784674442"
      requestBody:
        required: true
        description: Note to be created.
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateNotePayload'
            example:
              title: "Security Copilot — Consolidated Finding Analysis"
              content: "Verdict: Benign Positive — corporate installer. ..."
      responses:
        '200':
          description: Note created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreateNoteResponse'
        '201':
          description: Note created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreateNoteResponse'
        '400':
          description: Bad request (e.g. missing content, or wrong id/notable_time).
        '401':
          description: Unauthorized (token missing/invalid or insufficient capability).
        '404':
          description: Finding/investigation not found for the supplied id + notable_time.

components:
  securitySchemes:
    bearerAuth:
      type: apiKey
      in: header
      name: Authorization
  security:
    - bearerAuth: []
  schemas:
    CreateNotePayload:
      type: object
      required:
        - content
      properties:
        title:
          type: string
          description: The title of the note.
          example: "Create ticket - Note 1"
        content:
          type: string
          description: The data stored within the note.
          example: "Note Content for Create Ticket"
        files:
          type: array
          description: An array of file IDs to add to the note.
          items:
            type: string
          example:
            - "22a2e62e186f4dc4b33edde666534b4622a2e62e186f4dc4b33edde666534b46"
        type:
          type: string
          description: >
            OPTIONAL note type (sample shows "Task"). Omit for a plain finding
            note unless a specific type is required.
          example: "Task"
    CreateNoteResponse:
      type: object
      properties:
        id:
          type: string
          description: The ID of the created note.
          example: "189c4f74-ede9-4e71-a435-829a5e91e377"
