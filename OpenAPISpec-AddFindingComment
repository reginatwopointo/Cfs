openapi: 3.0.3
info:
  title: Splunk Enterprise Security — Add Finding Note (v1 investigations)
  description: >
    Creates a note on a Splunk Enterprise Security 8 FINDING (or investigation)
    via the Mission Control connector operation v1_investigations_add_general_note.
    Writes the note directly onto the finding — does NOT require creating a
    Mission Control investigation first.

    Confirmed source: the built-in Mission Control SOAR connector (builtin_mc_connector)
    registers this as:
      operationId  v1_investigations_add_general_note
      POST /v1/investigations/{id}/notes
      "Add the note to the finding or investigation."
    The working ES note-writing playbook feeds finding:finding_id into {id} and
    sends only {id, content}.

    KEY: {id} is the FINDING ID, passed as the FULL composite string
    (GUID@@notable@@time<epoch>), a single value — NOT a bare GUID and NOT a
    JSON array. e.g. 2694b8bf-...-7e61af8f4aad@@notable@@time1784674442
  version: 2.0.0

servers:
  - url: https://es-dev-accenture.splunkcloud.com:8089/servicesNS/nobody/missioncontrol

paths:
  /v1/investigations/{id}/notes:
    post:
      operationId: AddFindingNote
      summary: Add a note to an ES finding (or investigation)
      description: |
        Adds a note to an ES 8 finding or investigation, identified by {id}. Use
        this to write Security Copilot analysis directly onto a finding WITHOUT
        opening a Mission Control investigation. Mirrors the built-in MC connector
        operation v1_investigations_add_general_note.

        PATH PARAMETER:
        - id: the FINDING ID (or investigation id/display_id). For a finding, this
          is the FULL composite exactly as received — GUID@@notable@@time<epoch> —
          passed as ONE string. Do NOT split it, do NOT strip the @@notable@@time
          segment, and do NOT wrap it in a JSON array.
          e.g. 2694b8bf-2cb6-4e91-97d7-7e61af8f4aad@@notable@@time1784674442

        BODY (application/json):
        - content: full note body — paste the consolidated analysis here (REQUIRED).
        - title: optional short label for the note.
        - ai_generated: optional boolean; set true for Security Copilot notes.
        - files: optional array of file IDs.

        QUERY PARAMETER:
        - notable_time: optional. The finding _time (epoch/ISO/relative). The
          composite {id} already carries the time, so this is normally NOT needed
          (the reference playbook omits it). Include it only if a live test shows
          the finding is not located without it.

        #ExamplePrompts
        - Add a note to finding 2694b8bf-...@@notable@@time1784674442 with the Security Copilot analysis.
        - AddFindingNote id 2694b8bf-...@@notable@@time1784674442 content "Consolidated triage analysis ..."
        - Append this analysis to the ES finding without opening an investigation: [text]
      parameters:
        - name: id
          in: path
          required: true
          description: >
            The finding ID (full composite GUID@@notable@@time<epoch>) or an
            investigation id/display_id. Single string — never a JSON array.
          schema:
            type: string
            example: "2694b8bf-2cb6-4e91-97d7-7e61af8f4aad@@notable@@time1784674442"
        - name: notable_time
          in: query
          required: false
          description: >
            Optional. Finding _time (epoch/ISO/relative). Normally unnecessary
            because {id} carries the time; include only if a finding is not
            located without it.
          schema:
            type: string
            example: "1784674442"
      requestBody:
        required: true
        description: Note to be created.
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateNotePayload'
            example:
              title: "Security Copilot — Consolidated Finding Analysis"
              content: "Verdict: Benign Positive — corporate installer. ..."
              ai_generated: true
      responses:
        '200':
          description: Note created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreateNoteResponse'
        '201':
          description: Note created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreateNoteResponse'
        '400':
          description: Bad request (e.g. missing content, or malformed id).
        '401':
          description: Unauthorized (token missing/invalid or insufficient MC capability).
        '404':
          description: Finding/investigation not found for the supplied id.

components:
  securitySchemes:
    bearerAuth:
      type: apiKey
      in: header
      name: Authorization
  security:
    - bearerAuth: []
  schemas:
    CreateNotePayload:
      type: object
      required:
        - content
      properties:
        content:
          type: string
          description: The data stored within the note (the note body).
          example: "Note Content for Create Ticket"
        title:
          type: string
          description: Optional title of the note.
          example: "Create ticket - Note 1"
        ai_generated:
          type: boolean
          description: Optional. Set true for Security Copilot / AI-authored notes.
          example: true
        files:
          type: array
          description: Optional array of file IDs to add to the note.
          items:
            type: string
          example:
            - "22a2e62e186f4dc4b33edde666534b4622a2e62e186f4dc4b33edde666534b46"
    CreateNoteResponse:
      type: object
      properties:
        id:
          type: string
          description: The ID of the created note.
          example: "2f34ab66-929e-438d-b294-7ce5ea5415d4"
        incident_id:
          type: string
          description: The incident/investigation GUID the note is attached to.
          example: "c80a092f-9dca-484b-8733-9c3162ee4ab9"
        record_type:
          type: string
          description: Finding or Investigation.
          example: "Investigation"
        content:
          type: string
          example: "Note for task Create Ticket"
