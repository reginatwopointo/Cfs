openapi: 3.0.3
info:
  title: Splunk Enterprise Security — Add Finding Comment (notable_update)
  description: >
    Appends a comment (note) to one or more Splunk Enterprise Security
    findings (notable events) via the core ES notable_update endpoint.
    This does NOT create a Mission Control investigation — it writes the
    comment directly onto the finding. Optionally can set status / disposition,
    but for shadow-mode note-only use send ONLY ruleUIDs + comment.

    IMPORTANT — this endpoint differs from the Mission Control (MC) plugins:
      * BASE PATH is /services (core Splunk REST), NOT
        /servicesNS/nobody/missioncontrol.
      * BODY is application/x-www-form-urlencoded, NOT application/json.
        The MC v1/v2 JSON body shape does NOT apply here.
  version: 1.0.0

servers:
  - url: https://es-dev-accenture.splunkcloud.com:8089

paths:
  /services/notable_update:
    post:
      operationId: AddFindingComment
      summary: Add a comment to a Splunk ES finding (notable event)
      description: |
        Adds a comment to one or more ES findings (notable events) identified by
        their notable event_id, using the standard ES notable_update handler.
        Use this to write Security Copilot analysis output directly onto a
        finding WITHOUT opening a Mission Control investigation.

        REQUEST ENCODING: application/x-www-form-urlencoded (form fields), NOT
        JSON. Send output_mode=json (query) to receive a JSON response.

        REQUIRED fields:
        - ruleUIDs: a JSON-ARRAY-formatted STRING of one or more notable
          event_id values. For a single finding this is a one-element array,
          e.g. ["6f9c1a2b-...@@notable@@time1782438842"]. It MUST be sent as a
          JSON array string (square brackets), mirroring the MC finding_ids
          rule — a bare, unbracketed value is silently dropped and the comment
          is not attached.
        - comment: the full note body text to append to the finding.

        OPTIONAL fields (OMIT for shadow-mode note-only writes):
        - status: numeric ES review-status code (string), e.g. "5".
        - disposition: disposition CODE in the form "disposition:N" (never the
          label). Only send if intentionally dispositioning the finding.
        - newOwner: reassign the finding owner (username).
        - urgency: informational | low | medium | high | critical.

        OPEN ITEM (confirm on first live call): whether ruleUIDs takes the
        notable event_id or the source_event_id composite used elsewhere in the
        pipeline. Extract BOTH from index=notable in the gather step so either
        can be supplied.

        #ExamplePrompts
        - Add a comment to finding 6f9c1a2b-...@@notable@@time1782438842 with the Security Copilot analysis.
        - AddFindingComment ruleUIDs ["6f9c1a2b-...@@notable@@time1782438842"] comment "Consolidated triage analysis ..."
        - Append this note to the ES notable without creating an investigation: [note text]
      parameters:
        - name: output_mode
          in: query
          required: true
          description: Response format. Always json.
          schema:
            type: string
            enum: [json]
            default: json
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              type: object
              required:
                - ruleUIDs
                - comment
              properties:
                ruleUIDs:
                  type: string
                  description: >
                    JSON-array-formatted string of notable event_id(s).
                    Single finding = one-element array. MUST include square
                    brackets. Correct: ["6f9c1a2b-...@@notable@@time1782438842"].
                    Incorrect: 6f9c1a2b-...@@notable@@time1782438842
                  example: '["6f9c1a2b-150d-4c75-849d-7c5669755406@@notable@@time1782438842"]'
                comment:
                  type: string
                  description: The full note body to append to the finding.
                  example: "Consolidated triage analysis: curl download to /tmp assessed benign — corporate installer."
                status:
                  type: string
                  description: >
                    OPTIONAL numeric ES review-status code as a string. OMIT for
                    note-only shadow-mode writes.
                  example: "5"
                disposition:
                  type: string
                  description: >
                    OPTIONAL disposition CODE "disposition:N" (never the label).
                    OMIT for note-only shadow-mode writes.
                  example: "disposition:15"
                newOwner:
                  type: string
                  description: OPTIONAL — reassign the finding owner (username).
                urgency:
                  type: string
                  description: OPTIONAL — one of informational, low, medium, high, critical.
                  enum:
                    [informational, low, medium, high, critical,
                     Informational, Low, Medium, High, Critical]
      responses:
        '200':
          description: notable_update processed the request. Inspect `success`.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/NotableUpdateResponse'
        '400':
          description: Bad request (e.g. malformed ruleUIDs or missing comment).
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/NotableUpdateResponse'
        '401':
          description: Unauthorized (token missing/invalid or lacks edit_notable_events capability).
        '404':
          description: Endpoint not exposed on this stack — fall back to Logic App shim.

components:
  securitySchemes:
    bearerAuth:
      type: apiKey
      in: header
      name: Authorization
  security:
    - bearerAuth: []
  schemas:
    NotableUpdateResponse:
      type: object
      properties:
        success:
          type: boolean
          description: True when the comment was applied to the finding(s).
          example: true
        message:
          type: string
          description: Human-readable result, e.g. "1 event updated successfully."
          example: "1 event updated successfully."
        details:
          type: string
          description: Optional additional detail returned by the handler.
